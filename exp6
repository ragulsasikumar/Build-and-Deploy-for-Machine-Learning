
# EXPERIMENT 7: SIMPLE NEURAL NETWORK AND CNN
# Using TensorFlow/Keras for Image Classification

# Step 1: Import libraries
import numpy as np
import matplotlib.pyplot as plt
import tensorflow as tf

from tensorflow.keras.datasets import mnist
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import (
    Dense, Flatten, Conv2D, MaxPooling2D, Dropout
)
from tensorflow.keras.utils import to_categorical

print("TensorFlow Version:", tf.__version__)
print("Libraries Imported Successfully!")

# ==================================================
# PART A: LOAD AND PREPROCESS THE DATASET
# ==================================================

# Step 2: Load MNIST dataset
(X_train, y_train), (X_test, y_test) = mnist.load_data()

print("\nDataset Loaded Successfully!")
print("Training Images:", X_train.shape)
print("Testing Images:", X_test.shape)

# Step 3: Display sample images
plt.figure(figsize=(8, 4))

for i in range(10):
    plt.subplot(2, 5, i + 1)
    plt.imshow(X_train[i], cmap="gray")
    plt.title("Label: " + str(y_train[i]))
    plt.axis("off")

plt.suptitle("Sample MNIST Images")
plt.tight_layout()
plt.show()

# Step 4: Normalize pixel values
X_train = X_train.astype("float32") / 255.0
X_test = X_test.astype("float32") / 255.0

# Step 5: Convert labels to categorical format
y_train_cat = to_categorical(y_train, 10)
y_test_cat = to_categorical(y_test, 10)

print("\nData Preprocessing Completed!")

# ==================================================
# PART B: FEEDFORWARD NEURAL NETWORK
# ==================================================

# Step 6: Build the feedforward neural network
ff_model = Sequential([
    Flatten(input_shape=(28, 28)),
    Dense(128, activation="relu"),
    Dense(64, activation="relu"),
    Dense(10, activation="softmax")
])

# Step 7: Compile the model
ff_model.compile(
    optimizer="adam",
    loss="categorical_crossentropy",
    metrics=["accuracy"]
)

print("\nFEEDFORWARD NEURAL NETWORK")
ff_model.summary()

# Step 8: Train the feedforward network
ff_history = ff_model.fit(
    X_train,
    y_train_cat,
    epochs=5,
    batch_size=128,
    validation_split=0.1,
    verbose=1
)

# Step 9: Evaluate feedforward model
ff_loss, ff_accuracy = ff_model.evaluate(
    X_test,
    y_test_cat,
    verbose=0
)

print("\nFEEDFORWARD NETWORK RESULTS")
print("Test Loss:", round(ff_loss, 4))
print("Test Accuracy:", round(ff_accuracy * 100, 2), "%")

# Step 10: Plot feedforward model accuracy
plt.figure(figsize=(8, 5))

plt.plot(
    ff_history.history["accuracy"],
    label="Training Accuracy"
)

plt.plot(
    ff_history.history["val_accuracy"],
    label="Validation Accuracy"
)

plt.title("Feedforward Network Accuracy")
plt.xlabel("Epoch")
plt.ylabel("Accuracy")
plt.legend()
plt.grid(True)
plt.show()

# ==================================================
# PART C: PREPARE DATA FOR CNN
# ==================================================

# Step 11: Add the channel dimension
X_train_cnn = X_train.reshape(-1, 28, 28, 1)
X_test_cnn = X_test.reshape(-1, 28, 28, 1)

print("\nCNN Training Shape:", X_train_cnn.shape)
print("CNN Testing Shape:", X_test_cnn.shape)

# ==================================================
# PART D: BUILD CONVOLUTIONAL NEURAL NETWORK
# ==================================================

# Step 12: Create CNN architecture
cnn_model = Sequential([
    Conv2D(
        32,
        kernel_size=(3, 3),
        activation="relu",
        input_shape=(28, 28, 1)
    ),

    MaxPooling2D(pool_size=(2, 2)),

    Conv2D(
        64,
        kernel_size=(3, 3),
        activation="relu"
    ),

    MaxPooling2D(pool_size=(2, 2)),

    Flatten(),

    Dense(128, activation="relu"),

    Dropout(0.3),

    Dense(10, activation="softmax")
])

# Step 13: Compile CNN
cnn_model.compile(
    optimizer="adam",
    loss="categorical_crossentropy",
    metrics=["accuracy"]
)

print("\nCONVOLUTIONAL NEURAL NETWORK")
cnn_model.summary()

# Step 14: Train CNN
cnn_history = cnn_model.fit(
    X_train_cnn,
    y_train_cat,
    epochs=5,
    batch_size=128,
    validation_split=0.1,
    verbose=1
)

# ==================================================
# PART E: EVALUATE CNN
# ==================================================

# Step 15: Evaluate CNN model
cnn_loss, cnn_accuracy = cnn_model.evaluate(
    X_test_cnn,
    y_test_cat,
    verbose=0
)

print("\nCNN RESULTS")
print("Test Loss:", round(cnn_loss, 4))
print("Test Accuracy:", round(cnn_accuracy * 100, 2), "%")

# Step 16: Plot CNN accuracy
plt.figure(figsize=(8, 5))

plt.plot(
    cnn_history.history["accuracy"],
    label="Training Accuracy"
)

plt.plot(
    cnn_history.history["val_accuracy"],
    label="Validation Accuracy"
)

plt.title("CNN Accuracy")
plt.xlabel("Epoch")
plt.ylabel("Accuracy")
plt.legend()
plt.grid(True)
plt.show()

# Step 17: Plot CNN loss
plt.figure(figsize=(8, 5))

plt.plot(
    cnn_history.history["loss"],
    label="Training Loss"
)

plt.plot(
    cnn_history.history["val_loss"],
    label="Validation Loss"
)

plt.title("CNN Loss")
plt.xlabel("Epoch")
plt.ylabel("Loss")
plt.legend()
plt.grid(True)
plt.show()

# ==================================================
# PART F: MAKE PREDICTIONS
# ==================================================

# Step 18: Predict test images
predictions = cnn_model.predict(
    X_test_cnn[:10],
    verbose=0
)

predicted_labels = np.argmax(predictions, axis=1)

print("\nPREDICTIONS")
print("Actual Labels:   ", y_test[:10])
print("Predicted Labels:", predicted_labels)

# Step 19: Display predictions
plt.figure(figsize=(12, 5))

for i in range(10):
    plt.subplot(2, 5, i + 1)

    plt.imshow(X_test[i], cmap="gray")

    plt.title(
        "Actual: " + str(y_test[i]) +
        "\nPredicted: " + str(predicted_labels[i])
    )

    plt.axis("off")

plt.suptitle("CNN Image Classification Results")
plt.tight_layout()
plt.show()

# ==================================================
# PART G: COMPARE BOTH MODELS
# ==================================================

# Step 20: Compare model accuracy
print("\nMODEL COMPARISON")
print("Feedforward Accuracy:",
      round(ff_accuracy * 100, 2), "%")

print("CNN Accuracy:",
      round(cnn_accuracy * 100, 2), "%")

models = ["Feedforward NN", "CNN"]
accuracies = [
    ff_accuracy * 100,
    cnn_accuracy * 100
]

plt.figure(figsize=(7, 5))

plt.bar(models, accuracies)

plt.title("Feedforward NN vs CNN")
plt.ylabel("Test Accuracy (%)")
plt.ylim(0, 100)
plt.grid(axis="y")
plt.show()

# Step 21: Save trained models
ff_model.save("feedforward_model.keras")
cnn_model.save("cnn_model.keras")

print("\nModels Saved Successfully!")
print("Experiment Completed Successfully!")
