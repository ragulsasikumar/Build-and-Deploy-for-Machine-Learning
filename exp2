
# EXPERIMENT 2: SUPERVISED LEARNING MODELS
# SVM FOR BINARY AND MULTICLASS CLASSIFICATION
# RANDOM FOREST CLASSIFICATION

# Step 1: Import libraries
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.datasets import load_iris, load_breast_cancer
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.svm import SVC
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix
)

print("Libraries Imported Successfully!")

# ==================================================
# PART A: BINARY CLASSIFICATION USING SVM
# ==================================================

# Step 2: Load Breast Cancer dataset
cancer = load_breast_cancer()

X_binary = pd.DataFrame(
    cancer.data,
    columns=cancer.feature_names
)

y_binary = cancer.target

print("\nBINARY CLASSIFICATION DATASET")
print("Dataset Shape:", X_binary.shape)
print("Target Classes:", cancer.target_names)

# Step 3: Split dataset
X_train_b, X_test_b, y_train_b, y_test_b = train_test_split(
    X_binary,
    y_binary,
    test_size=0.2,
    random_state=42,
    stratify=y_binary
)

print("Training Samples:", X_train_b.shape[0])
print("Testing Samples:", X_test_b.shape[0])

# Step 4: Standardize features
scaler_binary = StandardScaler()

X_train_b_scaled = scaler_binary.fit_transform(X_train_b)
X_test_b_scaled = scaler_binary.transform(X_test_b)

# Step 5: Train binary SVM model
svm_binary = SVC(kernel="linear")

svm_binary.fit(X_train_b_scaled, y_train_b)

# Step 6: Make predictions
y_pred_svm_b = svm_binary.predict(X_test_b_scaled)

# Step 7: Evaluate binary SVM
svm_binary_accuracy = accuracy_score(
    y_test_b, y_pred_svm_b
)

print("\nBINARY SVM RESULTS")
print("Accuracy:",
      round(svm_binary_accuracy * 100, 2), "%")

print("\nClassification Report:")
print(classification_report(
    y_test_b,
    y_pred_svm_b,
    target_names=cancer.target_names
))

# Step 8: Confusion matrix
cm_binary = confusion_matrix(
    y_test_b, y_pred_svm_b
)

sns.heatmap(
    cm_binary,
    annot=True,
    fmt="d",
    cmap="Blues",
    xticklabels=cancer.target_names,
    yticklabels=cancer.target_names
)

plt.title("Binary SVM Confusion Matrix")
plt.xlabel("Predicted Class")
plt.ylabel("Actual Class")
plt.show()


# ==================================================
# PART B: MULTICLASS CLASSIFICATION USING SVM
# ==================================================

# Step 9: Load Iris dataset
iris = load_iris()

X_multi = pd.DataFrame(
    iris.data,
    columns=iris.feature_names
)

y_multi = iris.target

print("\nMULTICLASS CLASSIFICATION DATASET")
print("Dataset Shape:", X_multi.shape)
print("Classes:", iris.target_names)

# Step 10: Split multiclass dataset
X_train_m, X_test_m, y_train_m, y_test_m = train_test_split(
    X_multi,
    y_multi,
    test_size=0.2,
    random_state=42,
    stratify=y_multi
)

# Step 11: Standardize features
scaler_multi = StandardScaler()

X_train_m_scaled = scaler_multi.fit_transform(X_train_m)
X_test_m_scaled = scaler_multi.transform(X_test_m)

# Step 12: Train multiclass SVM
svm_multi = SVC(kernel="rbf")

svm_multi.fit(X_train_m_scaled, y_train_m)

# Step 13: Predict multiclass output
y_pred_svm_m = svm_multi.predict(X_test_m_scaled)

# Step 14: Evaluate multiclass SVM
svm_multi_accuracy = accuracy_score(
    y_test_m, y_pred_svm_m
)

print("\nMULTICLASS SVM RESULTS")
print("Accuracy:",
      round(svm_multi_accuracy * 100, 2), "%")

print("\nClassification Report:")
print(classification_report(
    y_test_m,
    y_pred_svm_m,
    target_names=iris.target_names
))

# Step 15: Plot confusion matrix
cm_multi = confusion_matrix(
    y_test_m, y_pred_svm_m
)

sns.heatmap(
    cm_multi,
    annot=True,
    fmt="d",
    cmap="Greens",
    xticklabels=iris.target_names,
    yticklabels=iris.target_names
)

plt.title("Multiclass SVM Confusion Matrix")
plt.xlabel("Predicted Class")
plt.ylabel("Actual Class")
plt.show()


# ==================================================
# PART C: RANDOM FOREST CLASSIFICATION
# ==================================================

# Step 16: Train Random Forest on Iris dataset
rf_model = RandomForestClassifier(
    n_estimators=100,
    max_depth=None,
    random_state=42
)

rf_model.fit(X_train_m, y_train_m)

# Step 17: Predict using Random Forest
y_pred_rf = rf_model.predict(X_test_m)

# Step 18: Evaluate Random Forest
rf_accuracy = accuracy_score(
    y_test_m, y_pred_rf
)

print("\nRANDOM FOREST RESULTS")
print("Accuracy:",
      round(rf_accuracy * 100, 2), "%")

print("\nClassification Report:")
print(classification_report(
    y_test_m,
    y_pred_rf,
    target_names=iris.target_names
))

# Step 19: Random Forest confusion matrix
cm_rf = confusion_matrix(
    y_test_m, y_pred_rf
)

sns.heatmap(
    cm_rf,
    annot=True,
    fmt="d",
    cmap="Oranges",
    xticklabels=iris.target_names,
    yticklabels=iris.target_names
)

plt.title("Random Forest Confusion Matrix")
plt.xlabel("Predicted Class")
plt.ylabel("Actual Class")
plt.show()

# Step 20: Display feature importance
importance = pd.Series(
    rf_model.feature_importances_,
    index=iris.feature_names
).sort_values(ascending=False)

print("\nFEATURE IMPORTANCE")
print(importance)

importance.plot(
    kind="bar",
    title="Random Forest Feature Importance"
)

plt.ylabel("Importance Score")
plt.tight_layout()
plt.show()


# ==================================================
# PART D: COMPARE MODEL PERFORMANCE
# ==================================================

# Step 21: Compare accuracy scores
results = pd.DataFrame({
    "Model": [
        "Binary SVM",
        "Multiclass SVM",
        "Random Forest"
    ],
    "Accuracy (%)": [
        svm_binary_accuracy * 100,
        svm_multi_accuracy * 100,
        rf_accuracy * 100
    ]
})

print("\nMODEL PERFORMANCE COMPARISON")
print(results.round(2))

# Step 22: Plot comparison
plt.figure(figsize=(8, 5))

sns.barplot(
    data=results,
    x="Model",
    y="Accuracy (%)"
)

plt.title("SVM and Random Forest Accuracy Comparison")
plt.ylim(0, 105)
plt.ylabel("Accuracy (%)")
plt.tight_layout()
plt.show()

print("\nExperiment Completed Successfully!")
