
# EXPERIMENT 6: UNSUPERVISED LEARNING MODELS
# K-MEANS CLUSTERING AND PCA

# Step 1: Import libraries
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.datasets import load_iris
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.decomposition import PCA
from sklearn.metrics import silhouette_score

print("Libraries Imported Successfully!")

# ==================================================
# PART A: LOAD AND EXPLORE THE DATASET
# ==================================================

# Step 2: Load Iris dataset
iris = load_iris()

X = pd.DataFrame(
    iris.data,
    columns=iris.feature_names
)

y = iris.target

print("\nDataset Loaded Successfully!")
print("\nFirst Five Rows:")
print(X.head())

print("\nDataset Shape:", X.shape)

print("\nStatistical Summary:")
print(X.describe())

print("\nMissing Values:")
print(X.isnull().sum())

# ==================================================
# PART B: DATA PREPROCESSING
# ==================================================

# Step 3: Standardize the features
scaler = StandardScaler()

X_scaled = scaler.fit_transform(X)

print("\nFeature Scaling Completed!")
print("Scaled Data Shape:", X_scaled.shape)

# ==================================================
# PART C: K-MEANS CLUSTERING
# ==================================================

# Step 4: Create K-Means model
kmeans = KMeans(
    n_clusters=3,
    random_state=42,
    n_init=10
)

# Step 5: Fit the model and predict clusters
clusters = kmeans.fit_predict(X_scaled)

print("\nK-Means Clustering Completed!")

# Step 6: Display cluster assignments
df_cluster = X.copy()

df_cluster["Cluster"] = clusters
df_cluster["Actual Species"] = iris.target_names[y]

print("\nCluster Assignments:")
print(df_cluster.head(10))

print("\nCluster Counts:")
print(df_cluster["Cluster"].value_counts().sort_index())

# Step 7: Display cluster centers
print("\nCluster Centers:")
print(kmeans.cluster_centers_)

# Step 8: Calculate inertia
print("\nK-Means Inertia:")
print(round(kmeans.inertia_, 2))

# Step 9: Calculate silhouette score
score = silhouette_score(X_scaled, clusters)

print("\nSilhouette Score:")
print(round(score, 4))

# Step 10: Visualize clusters using two original features
plt.figure(figsize=(8, 5))

plt.scatter(
    X.iloc[:, 0],
    X.iloc[:, 1],
    c=clusters,
    cmap="viridis",
    s=60
)

plt.title("K-Means Clustering")
plt.xlabel(iris.feature_names[0])
plt.ylabel(iris.feature_names[1])
plt.colorbar(label="Cluster")
plt.grid(True)
plt.show()

# ==================================================
# PART D: FIND OPTIMAL NUMBER OF CLUSTERS
# USING ELBOW METHOD
# ==================================================

# Step 11: Calculate inertia for different K values
inertia_values = []

for k in range(1, 11):
    model = KMeans(
        n_clusters=k,
        random_state=42,
        n_init=10
    )

    model.fit(X_scaled)
    inertia_values.append(model.inertia_)

print("\nINERTIA VALUES:")
for k, inertia in enumerate(inertia_values, start=1):
    print("K =", k, "Inertia =", round(inertia, 2))

# Step 12: Plot Elbow graph
plt.figure(figsize=(8, 5))

plt.plot(
    range(1, 11),
    inertia_values,
    marker="o"
)

plt.title("Elbow Method for K-Means")
plt.xlabel("Number of Clusters (K)")
plt.ylabel("Inertia")
plt.xticks(range(1, 11))
plt.grid(True)
plt.show()

# ==================================================
# PART E: PRINCIPAL COMPONENT ANALYSIS (PCA)
# ==================================================

# Step 13: Apply PCA
pca = PCA(n_components=2)

X_pca = pca.fit_transform(X_scaled)

print("\nPCA Completed Successfully!")
print("Original Features:", X_scaled.shape[1])
print("Reduced Features:", X_pca.shape[1])

# Step 14: Display PCA data
pca_df = pd.DataFrame(
    X_pca,
    columns=["Principal Component 1",
             "Principal Component 2"]
)

pca_df["Cluster"] = clusters

print("\nPCA Transformed Dataset:")
print(pca_df.head())

# Step 15: Display explained variance
print("\nExplained Variance Ratio:")
print(pca.explained_variance_ratio_)

print(
    "Total Variance Retained:",
    round(sum(pca.explained_variance_ratio_) * 100, 2),
    "%"
)

# Step 16: Visualize PCA components
plt.figure(figsize=(8, 6))

plt.scatter(
    X_pca[:, 0],
    X_pca[:, 1],
    c=clusters,
    cmap="viridis",
    s=60
)

plt.title("PCA Visualization of K-Means Clusters")
plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")
plt.colorbar(label="Cluster")
plt.grid(True)
plt.show()

# ==================================================
# PART F: COMPARE ACTUAL SPECIES WITH CLUSTERS
# ==================================================

# Step 17: Visualize actual species
plt.figure(figsize=(8, 6))

for species_id, species_name in enumerate(iris.target_names):
    mask = y == species_id

    plt.scatter(
        X_pca[mask, 0],
        X_pca[mask, 1],
        label=species_name,
        s=50
    )

plt.title("PCA Visualization of Actual Iris Species")
plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")
plt.legend()
plt.grid(True)
plt.show()

# Step 18: Compare clusters and actual labels
comparison = pd.crosstab(
    pd.Series(y, name="Actual Species"),
    pd.Series(clusters, name="K-Means Cluster")
)

print("\nACTUAL SPECIES VS CLUSTERS")
print(comparison)

# ==================================================
# PART G: SAVE THE RESULTS
# ==================================================

# Step 19: Save clustered and reduced data
df_cluster.to_csv(
    "kmeans_clustered_iris.csv",
    index=False
)

pca_df.to_csv(
    "pca_reduced_iris.csv",
    index=False
)

print("\nClustered dataset saved successfully!")
print("PCA dataset saved successfully!")

# Step 20: Final output
print("\nExperiment Completed Successfully!")
